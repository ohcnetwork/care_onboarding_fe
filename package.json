{
  "name": "care_onboarding_fe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Guided facility setup inside CARE",
  "license": "MIT",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "preview": "vite preview",
    "build": "npm run typecheck && npm run validate:data && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts src/care/*.test.ts",
    "test:browser": "playwright test",
    "validate:data": "node scripts/validate-data.mjs",
    "convert": "node scripts/convert-content.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.13.4",
    "lucide-react": "^0.468.0",
    "tailwind-merge": "^3.2.0"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.7.0",
    "postcss": "^8.5.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.3",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
